generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String           @id @default(uuid())
  role                Role             @default(VOLUNTEER)
  name                String
  email               String           @unique
  passwordHash        String
  volunteerId         String?          @unique
  phone               String?
  status              UserStatus       @default(ACTIVE)
  isMasterAdmin       Boolean          @default(false)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  reviewedSubmissions TaskSubmission[] @relation("AdminReviewedSubmissions")
  submissions         TaskSubmission[] @relation("VolunteerSubmissions")
  assignedTasks       Task[]           @relation("AssignedTasks")
  createdTasks        Task[]           @relation("CreatedTasks")

  @@map("users")
}

model Task {
  id             String          @id @default(uuid())
  title          String
  description    String
  expectedHours  Float
  assignmentDate DateTime        @default(now())
  deadline       DateTime
  status         TaskStatus      @default(ASSIGNED)
  assignedToId   String
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  submission     TaskSubmission?
  assignedTo     User            @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("CreatedTasks", fields: [createdById], references: [id])

  @@index([assignedToId, status])
  @@map("tasks")
}

model TaskSubmission {
  id              String       @id @default(uuid())
  taskId          String       @unique
  volunteerId     String
  actualHours     Float
  completionNotes String
  submittedAt     DateTime     @default(now())
  reviewStatus    ReviewStatus @default(PENDING)
  approvedHours   Float        @default(0.0)
  reviewNotes     String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reviewedBy      User?        @relation("AdminReviewedSubmissions", fields: [reviewedById], references: [id])
  task            Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  volunteer       User         @relation("VolunteerSubmissions", fields: [volunteerId], references: [id], onDelete: Cascade)

  @@index([volunteerId, reviewStatus])
  @@index([reviewStatus])
  @@map("task_submissions")
}

enum Role {
  ADMIN
  VOLUNTEER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  ASSIGNED
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
